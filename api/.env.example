# Development defaults. Copy to api/.env; never commit the copy.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Defaults to the repository's .data directory, independent of working directory.
# Production must use an absolute path outside the release directory.
# DATA_DIR=/var/lib/gdg-landing

# Enable only behind a local nginx proxy which OVERWRITES X-Forwarded-For.
TRUST_PROXY=false
